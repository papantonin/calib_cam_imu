# Only the verified official archive is used. No network operation at configure time.
file(READ "${PROJECT_SOURCE_DIR}/dependencies.json" lock)
string(JSON CALIB_APRILTAG_VERSION GET "${lock}" apriltag version)
string(JSON CALIB_APRILTAG_COMMIT GET "${lock}" apriltag commit)
string(JSON archive GET "${lock}" apriltag archive)
string(JSON sha GET "${lock}" apriltag sha256)
set(archive_path "${PROJECT_SOURCE_DIR}/.deps/${archive}")
if(NOT EXISTS "${archive_path}")
  message(FATAL_ERROR "Missing ${archive_path}. Run scripts/install_dependencies.sh --sources-only")
endif()
file(SHA256 "${archive_path}" actual_sha)
if(NOT actual_sha STREQUAL sha)
  message(FATAL_ERROR "AprilTag archive checksum mismatch")
endif()
include(FetchContent)
function(calib_add_apriltag)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_EXAMPLES OFF)
  set(BUILD_PYTHON_WRAPPER OFF)
  set(BUILD_TESTING OFF)
  FetchContent_Declare(apriltag URL "${archive_path}" URL_HASH "SHA256=${sha}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE SYSTEM)
  FetchContent_MakeAvailable(apriltag)
endfunction()
calib_add_apriltag()
