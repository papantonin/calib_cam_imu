file(READ "${PROJECT_SOURCE_DIR}/dependencies.json" lock)
string(JSON CALIB_CERES_VERSION GET "${lock}" ceres version)
string(JSON ceres_commit GET "${lock}" ceres commit)
string(JSON expected_hash GET "${lock}" ceres sha256)
set(ceres_prefix "${PROJECT_SOURCE_DIR}/.deps/ceres-install-${ceres_commit}")
if(NOT EXISTS "${ceres_prefix}/calib-provenance.json")
  message(FATAL_ERROR "Missing locked Ceres build. Run scripts/install_dependencies.sh --sources-only")
endif()
file(READ "${ceres_prefix}/calib-provenance.json" provenance)
string(JSON actual_hash GET "${provenance}" dependency sha256)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Ceres build provenance does not match dependencies.json")
endif()
set(Ceres_DIR "${ceres_prefix}/lib/cmake/Ceres")
find_package(Ceres ${CALIB_CERES_VERSION} EXACT REQUIRED CONFIG PATHS "${ceres_prefix}" NO_DEFAULT_PATH)
